# Copy to .env. Without AI settings, /advice returns a "not configured" notice.

# --- Option A: free, hosted. Google Gemini free tier (key from aistudio.google.com) ---
AI_PROVIDER=openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=            # a Flash model name copied from AI Studio

# --- Option B: free, fully local. Ollama (ollama.com), no key needed ---
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b

# --- Option C: paid. Anthropic ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

DATABASE_URL=postgresql+psycopg://sixthman:sixthman@localhost:5432/sixthman
